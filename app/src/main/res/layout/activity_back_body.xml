<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/keep_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_back_body_zone"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/keep_on_surface"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSelectedZone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tap_body_part_instruction"
        android:textSize="16sp"
        android:textStyle="italic"
        android:textColor="@color/keep_on_surface"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/imgBackBodyMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:src="@drawable/body_map_back_14_zones_back"
        android:contentDescription="Back Body Map"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirm_selection"
        android:enabled="false"
        app:backgroundTint="@color/keep_surface"
        android:textColor="@color/keep_on_surface" />

</LinearLayout>
