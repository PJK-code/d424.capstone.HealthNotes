<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keep_background"
    tools:context=".UI.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/keep_surface"
            app:cardCornerRadius="27dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/keep_card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/keep_on_surface_variant"
                    android:contentDescription="Search Icon" />

                <EditText
                    android:id="@+id/editSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:textColor="@color/keep_on_surface"
                    android:textColorHint="@color/keep_on_surface_variant"
                    android:textSize="18sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_all"
                    android:checked="true"
                    android:textSize="14sp"
                    android:textColor="@color/keep_on_surface"
                    app:chipBackgroundColor="@color/keep_surface"
                    app:chipStrokeColor="@color/keep_card_border" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipIllness"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_illness"
                    android:textSize="14sp"
                    android:textColor="@color/tag_illness_stroke"
                    app:chipBackgroundColor="@color/keep_surface"
                    app:chipStrokeColor="@color/tag_illness_stroke" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipInjury"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_injury"
                    android:textSize="14sp"
                    android:textColor="@color/tag_injury_stroke"
                    app:chipBackgroundColor="@color/keep_surface"
                    app:chipStrokeColor="@color/tag_injury_stroke" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewNotes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/textEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/empty_notes"
        android:textColor="@color/keep_on_surface_variant"
        android:textSize="18sp"
        android:visibility="gone" />


    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCreateNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/create_note_fab"
        android:textSize="16sp"
        android:textColor="@color/keep_on_surface"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/keep_on_surface"
        app:backgroundTint="@color/keep_surface" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
